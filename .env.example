# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Password the club types to set captains, save tactics and move red cards to the CPU
CLUB_PASSWORD=

# Long random string. Vercel Cron sends it automatically; add the same value as a GitHub Actions secret.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# EA club and platform (Sarma gang on PS5 / Xbox Series / PC)
CLUB_ID=837026
PLATFORM=common-gen5

# Optional: post every new result to a Discord channel (Channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Optional: public address of the site, used for links in Discord posts (defaults to the Vercel URL)
SITE_URL=

# Optional: Telegram bot teammates send screenshots to (token from @BotFather). After deploying,
# run: node --env-file=.env.local scripts/telegram-setup.mjs
TELEGRAM_TOKEN=

# Local development only: read EA data from ./fixtures instead of the internet
# EA_FIXTURE_DIR=./fixtures
